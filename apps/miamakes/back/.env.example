PORT=3010

# Nectarine Postgres — required in production (NODE_ENV=production).
# Locally, omit every PG_* key to use in-memory seed recipes.
# Partial PG_* (some set, some missing) always fails boot.
# Key names are declared in nectarine.config.yaml under database.postgres.env.
PG_USER=miamakes
PG_PASS=change-me-postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=miamakes

# Optional override (defaults to nectarine.config.yaml beside this package)
# NECTARINE_CONFIG=./nectarine.config.yaml

# Fail boot without Postgres even when NODE_ENV is not production
# REQUIRE_DATABASE=1

# Allow seed fallback even when NODE_ENV=production (local only)
# ALLOW_SEED_FALLBACK=1

# CORS — Vite proxies /api, so this is only needed for direct browser calls
# CORS_ORIGIN=http://localhost:5174
