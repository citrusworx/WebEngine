# KiwiPress API (apps/kiwipress/back). Copy to .env and export in the
# same shell as `yarn workspace @citrusworx/kiwipressapp-back dev`.
# The process reads process.env — it does not load this file by itself.
# Never commit real tokens or passwords.

KIWIPRESS_API_PORT=8787

# When set, /__kiwipress (except health) and /provision/* require
# Authorization: Bearer or X-KiwiPress-Token. Leave empty for loopback-only local use.
KIWIPRESS_GATEWAY_TOKEN=

# Server-only. Required for POST /provision/apply. Plan works without it.
# Do not put this on the Vite process or in front/.env.
# DO_TOKEN=

# Optional WordPress REST entry. Omit WP_URL for nectarine-only CMS.
# WP_URL=
# WP_API=wp-json/wp/v2
# WP_USER=
# WP_APP_PASSWORD=
# WP_TOKEN=
# WP_API_KEY=

# Persistence. Unset → ./data/kiwipress-cms.json under the back cwd.
# KIWIPRESS_CMS_FILE=
# KIWIPRESS_PG_DB=
# PG_DB=
