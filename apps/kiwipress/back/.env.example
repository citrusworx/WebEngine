# KiwiPress API (apps/kiwipress/back). Copy to .env. The back process
# loads this file on startup if present. Keys already set in the shell
# win (including empty exports). Never commit real tokens or passwords.

KIWIPRESS_API_PORT=8787

# When set, /__kiwipress (except health) and /provision/* require
# Authorization: Bearer or X-KiwiPress-Token. Leave empty for loopback-only local use.
KIWIPRESS_GATEWAY_TOKEN=

# Server-only. Required for POST /provision/apply and /provision/destroy.
# Plan works without it.
# Do not put this on the Vite process or in front/.env.
# DO_TOKEN=

# Server-only. Required to pair a WordPress site. 32 bytes, base64 or 64 hex
# characters. Encrypts the application password at rest (AES-256-GCM).
# The API refuses to pair when this is missing. Never put it in front/.env.
# Generate:
#   node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# KIWIPRESS_SECRET_KEY=

# Optional WordPress REST entry. Omit WP_URL for nectarine-only CMS.
# WP_URL=
# WP_API=wp-json/wp/v2
# WP_USER=
# WP_APP_PASSWORD=
# WP_TOKEN=
# WP_API_KEY=

# Persistence. Unset → ./data/kiwipress-cms.json under the back cwd.
# KIWIPRESS_CMS_FILE=
# KIWIPRESS_PG_DB=
# PG_DB=
