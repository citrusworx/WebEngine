# KiwiPress Vite app (apps/kiwipress/front). Copy to .env — Vite loads it.
# Never commit real tokens.

# Proxy target for /__kiwipress and /provision (vite.config.ts). Not a VITE_ public var.
KIWIPRESS_API_URL=http://localhost:8787

# Same value as KIWIPRESS_GATEWAY_TOKEN on the API when you set one.
# Sent as Authorization: Bearer. Optional on laptop loopback.
VITE_KIWIPRESS_GATEWAY_TOKEN=
