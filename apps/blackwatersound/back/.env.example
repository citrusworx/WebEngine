PORT=3001

# KiwiPress / WordPress (optional locally — omit to use seed content)
WP_URL=http://wp.blackwatersound.local
WP_USERNAME=admin
WP_APP_PASSWORD=
# WP_API_BASE=wp-json/wp/v2

# Nectarine Postgres — required in production (NODE_ENV=production).
# Locally, omit all PG_* keys to use seed products + JSON waitlist.
# Partial PG_* (some set, some missing) always fails boot.
# Keys are declared in nectarine.config.yaml under database.postgres.env
PG_USER=blackwater
PG_PASS=change-me-postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=blackwater_sound

# Optional override for config path (defaults next to package root)
# NECTARINE_CONFIG=./nectarine.config.yaml

# Fail boot without Postgres even when NODE_ENV is not production
# REQUIRE_DATABASE=1

# Allow seed fallback even when NODE_ENV=production (local/dev only)
# ALLOW_SEED_FALLBACK=1

# Runtime JSON waitlist fallback when Postgres env is fully unset
# RUNTIME_DATA_DIR=./src/data/runtime

# CORS — only needed when front calls api subdomain directly
# CORS_ORIGIN=http://www.blackwatersound.local

# Front (Docker nginx proxies /api — leave empty for compose stack)
# VITE_API_BASE=

# MinIO (optional until media upload is wired)
# S3_ENDPOINT=http://minio.blackwatersound.local
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_MEDIA=blackwater-media
