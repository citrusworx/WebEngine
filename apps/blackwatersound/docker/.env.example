# Copy to docker/.env before: docker compose up -d

# ── Postgres service (container bootstrap) ──
POSTGRES_USER=blackwater
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=blackwater_sound

# ── Nectarine / API (vendor-specific — maps to postgres service) ──
PG_USER=blackwater
PG_PASS=change-me-postgres
PG_HOST=postgres
PG_PORT=5432
PG_DB=blackwater_sound

# ── WordPress (KiwiPress) ──
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=change-me-wp-db
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_HOST=mariadb

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-wp-admin
WP_ADMIN_EMAIL=admin@blackwatersound.local
WP_URL=http://wp.blackwatersound.local
WP_USERNAME=admin
WP_APP_PASSWORD=

# ── MinIO (KiwiEngine storage) ──
MINIO_ROOT_USER=blackwater
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://minio.blackwatersound.local
S3_ACCESS_KEY=blackwater
S3_SECRET_KEY=change-me-minio
S3_BUCKET_MEDIA=blackwater-media
S3_BUCKET_UPLOADS=blackwater-uploads
S3_BUCKET_PUBLIC=blackwater-public

# ── Back API ──
PORT=3001
CORS_ORIGIN=http://www.blackwatersound.local

# ── Front build (same-origin /api via nginx — leave empty) ──
VITE_API_BASE=

# ── Traefik dashboard (optional basic auth user:password hash) ──
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$H6uskkkW$$IgXLP6ewTrSuBkTrqE8wj/
