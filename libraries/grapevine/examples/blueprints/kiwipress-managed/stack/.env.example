# KiwiPress managed env template.
# WORDPRESS_DB_* and PG_* are overwritten at apply from DigitalOcean managed DB connections.
# Replace REPLACE_ME values. Do not commit real passwords.

DOMAIN=example.test
WP_HOST=wp.example.test
API_HOST=api.example.test
FRONT_HOST=www.example.test
MINIO_HOST=minio.example.test
MINIO_CONSOLE_HOST=minio-console.example.test
TRAEFIK_HOST=traefik.example.test

WP_URL=http://wp.example.test
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=REPLACE_ME
WP_ADMIN_EMAIL=admin@example.test
WP_TITLE=KiwiPress

WORDPRESS_DB_HOST=REPLACE_MANAGED_MYSQL_HOST
WORDPRESS_DB_PORT=25060
WORDPRESS_DB_USER=doadmin
WORDPRESS_DB_PASSWORD=REPLACE_ME
WORDPRESS_DB_NAME=defaultdb

PG_USER=doadmin
PG_PASS=REPLACE_ME
PG_HOST=REPLACE_MANAGED_PG_HOST
PG_PORT=25060
PG_DB=defaultdb

MINIO_ROOT_USER=kiwipress
MINIO_ROOT_PASSWORD=REPLACE_ME
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=kiwipress
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET_MEDIA=kiwipress-media

PORT=3001
CORS_ORIGIN=http://www.example.test
VITE_API_BASE=http://api.example.test

KIWIPRESS_BACK_IMAGE=
KIWIPRESS_FRONT_IMAGE=
COMPOSE_PROFILES=
