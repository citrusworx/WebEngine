{
    "name": "@citrusworx/grapevine",
    "version": "0.2.2",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "grape": "./dist/bin/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "examples/blueprints"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "rimraf dist tsconfig.tsbuildinfo",
        "build": "yarn clean && tsc -b && node ./scripts/copy-blueprints.mjs && chmod +x dist/bin/cli.js",
        "dev": "tsc -w",
        "prepack": "yarn build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui"
    },
    "dependencies": {
        "@citrusworx/types": "^0.2.0",
        "axios": "^1.13.6",
        "commander": "^15.0.0",
        "js-yaml": "^4.1.1",
        "sshpk": "^1.18.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/js-yaml": "^4",
        "@types/node": "^25.5.0",
        "@types/sshpk": "^1",
        "rimraf": "^6.1.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.4"
    }
}
