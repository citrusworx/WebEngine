{
  "name": "@citrusworx/sigjs",
  "version": "0.3.0",
  "description": "Standalone signals, JSX-to-DOM runtime, and client router for TypeScript and JavaScript. No framework required.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./sig-router": {
      "types": "./dist/sig-router.d.ts",
      "default": "./dist/sig-router.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "yarn build",
    "test": "yarn run --top-level playwright test --config ../../playwright.config.ts --project=sigjs"
  },
  "devDependencies": {
    "jsdom": "^29.0.1",
    "typescript": "^5.9.3"
  }
}
