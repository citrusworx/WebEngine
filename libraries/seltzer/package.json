{
    "name": "@citrusworx/seltzer",
    "version": "0.2.0",
    "description": "An execution environment library",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "dev": "ts-node src/index.ts",
        "prepack": "yarn build",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "ts-node": "^10.9.1",
        "typescript": "^6.0.2"
    }
}
