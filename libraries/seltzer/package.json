{
    "name": "@citrusworx/seltzer",
    "version": "0.9.0",
    "description": "Small Node HTTP runtime: object routes, ResponseData handlers, and a named request pipeline",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "dev": "ts-node src/index.ts",
        "prepack": "yarn build",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.types.json",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "ts-node": "^10.9.1",
        "typescript": "^6.0.2",
        "vitest": "^4.1.4"
    }
}
