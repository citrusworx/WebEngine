{
    "name": "@citrusworx/juiceui",
    "version": "0.1.1",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./styles": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/index.css"
        },
        "./themes/aquaflux.css": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/themes/aquaflux.css"
        },
        "./themes/kiwipress.css": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/themes/kiwipress.css"
        },
        "./themes/citrusmint.css": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/themes/citrusmint.css"
        },
        "./styles/themes/aquaflux": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/themes/aquaflux.css"
        },
        "./styles/themes/kiwipress": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/themes/kiwipress.css"
        },
        "./styles/themes/citrusmint": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/themes/citrusmint.css"
        }
    },
    "files": [
        "dist"
    ],
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Edge versions",
        "last 2 Firefox versions",
        "last 2 Safari major versions",
        "iOS >= 16.4"
    ],
    "sideEffects": [
        "./dist/index.css",
        "./dist/themes/aquaflux.css",
        "./dist/themes/kiwipress.css",
        "./dist/themes/citrusmint.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@citrusworx/sigjs": "^0.1.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/gulp": "^4.0.18",
        "@types/gulp-postcss": "^8.0.6",
        "@types/gulp-rename": "^2",
        "@types/gulp-sass": "^6.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/sass": "^1.45.0",
        "autoprefixer": "^10.4.27",
        "cssnano": "^7.1.3",
        "gulp": "^5.0.1",
        "gulp-postcss": "^10.0.0",
        "gulp-rename": "^2.1.0",
        "gulp-sass": "^6.0.1",
        "js-yaml": "^4.1.1",
        "jsdom": "^29.0.1",
        "postcss": "^8.5.8",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "sass": "^1.98.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.2"
    },
    "scripts": {
        "dev": "gulp dev & vite dev --watch",
        "build": "gulp build --gulpfile gulp.ts && vite build && tsc -p tsconfig.types.json",
        "prepack": "yarn build",
        "verify": "yarn build && yarn test",
        "test": "node ../../node_modules/vitest/vitest.mjs run",
        "test:e2e": "playwright test"
    }
}
