{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/js/juice.ts",
    "src/js/src/nav/navigation.ts",
    "src/js/src/accordion/accordion-runtime.ts",
    "src/js/src/tabs/tabs-runtime.ts",
    "src/js/src/modal/modal-runtime.ts",
    "src/js/src/drawer/drawer-runtime.ts",
    "src/js/src/toast/toast-runtime.ts",
    "src/js/src/popover/popover-runtime.ts",
    "src/js/src/tooltip/tooltip-runtime.ts",
    "src/js/src/wizard/wizard-runtime.ts",
    "src/js/src/combobox/combobox-runtime.ts",
    "src/js/src/banner/banner-runtime.ts",
    "src/js/src/menu/menu-runtime.ts",
    "src/js/src/switch/switch-runtime.ts",
    "src/js/src/slider/slider-runtime.ts",
    "src/js/src/checkbox/checkbox-runtime.ts",
    "src/js/src/radio/radio-runtime.ts",
    "src/js/src/shared/events.ts",
    "src/js/src/shared/focus.ts",
    "src/js/src/shared/ids.ts",
    "src/js/src/shared/overlays.ts",
    "src/tokens/**/*.ts",
    "src/themes/**/*.ts",
    "src/jsx.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/native/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
