{
    "compilerOptions": {
        "target": "ES2020",
        "types": ["node"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "sourceMap": true,
        "declaration": true,
        "noImplicitAny": true,
        "rootDir": "./src",
        "outDir": "dist"
    },
    "include": ["src"],
    "exclude": [
        "node_modules",
        "dist",
        "src/**/*.test.ts",
        "src/**/__fixtures__/**"
    ]
}