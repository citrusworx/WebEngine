{
    "name": "@citrusworx/nectarine",
    "version": "0.1.0",
    "description": "YAML-driven query compiler and database adapters for CitrusWorx / WebEngine",
    "license": "MIT",
    "author": "CitrusWorx",
    "homepage": "https://github.com/citrusworx/WebEngine/tree/master/libraries/nectarine",
    "bugs": {
        "url": "https://github.com/citrusworx/WebEngine/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/citrusworx/WebEngine.git",
        "directory": "libraries/nectarine"
    },
    "keywords": [
        "nectarine",
        "yaml",
        "sql",
        "compiler",
        "postgres",
        "mysql",
        "mongodb",
        "citrusworx",
        "webengine"
    ],
    "engines": {
        "node": ">=18"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./config": {
            "types": "./dist/config/index.d.ts",
            "default": "./dist/config/index.js"
        },
        "./api": {
            "types": "./dist/config/api.d.ts",
            "default": "./dist/config/api.js"
        },
        "./compiler": {
            "types": "./dist/compiler/compiler.d.ts",
            "default": "./dist/compiler/compiler.js"
        },
        "./adapters/mg": {
            "types": "./dist/adapters/mg/mgz.d.ts",
            "default": "./dist/adapters/mg/mgz.js"
        },
        "./adapters/ms": {
            "types": "./dist/adapters/ms/msqlz.d.ts",
            "default": "./dist/adapters/ms/msqlz.js"
        },
        "./adapters/pg": {
            "types": "./dist/adapters/pg/pgz.d.ts",
            "default": "./dist/adapters/pg/pgz.js"
        },
        "./util": {
            "types": "./dist/util/util.d.ts",
            "default": "./dist/util/util.js"
        }
    },
    "dependencies": {
        "js-yaml": "^4.1.1"
    },
    "peerDependencies": {
        "mongodb": "^7.0.0",
        "mysql2": "^3.0.0",
        "pg": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "mongodb": {
            "optional": true
        },
        "mysql2": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^25.6.2",
        "@types/pg": "^8.18.0",
        "eslint": "^10.0.3",
        "express": "^5.2.1",
        "jest": "^30.3.0",
        "mongodb": "^7.1.0",
        "mysql2": "^3.24.4",
        "pg": "^8.20.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3",
        "vitest": "^4.1.4",
        "zod": "^4.3.6"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "prepack": "yarn build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:all": "playwright test && vitest run",
        "example": "tsx examples/showcase.ts",
        "pack:check": "npm pack --dry-run",
        "verify": "yarn typecheck && yarn build && yarn test && yarn pack:check"
    }
}
